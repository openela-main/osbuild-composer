diff --git a/vendor/github.com/osbuild/images/data/distrodefs/rhel-9/imagetypes.yaml b/vendor/github.com/osbuild/images/data/distrodefs/rhel-9/imagetypes.yaml
index c472a39c2..db65f748f 100644
--- a/vendor/github.com/osbuild/images/data/distrodefs/rhel-9/imagetypes.yaml
+++ b/vendor/github.com/osbuild/images/data/distrodefs/rhel-9/imagetypes.yaml
@@ -2813,6 +2813,8 @@ image_types:
             # XXX: sadly the osbuild options are upper case for "Unit" vs lower above :(
             Unit:
               ConditionPathExists: "!/usr/libexec/greenboot/greenboot"
+      # Enable bootupd metadata generation for ostree commits (9.6+ only)
+      bootupd_gen_metadata: true
       enabled_services: &enabled_services_edge
         # XXX: shared with 9.2
         - "NetworkManager.service"
@@ -2822,6 +2824,8 @@ image_types:
         # only on rhel-9.2+ and centos
         - "ignition-firstboot-complete.service"
         - "coreos-ignition-write-issues.service"
+        # only on rhel-9.6+
+        - "bootloader-update.service"
       conditions: &conditions_edge_commit_image_config
         "rhel-9.1 and below do not have ignition":
           when:
@@ -2833,6 +2837,23 @@ image_types:
               - "firewalld.service"
               - "sshd.service"
               - "fdo-client-linuxapp.service"
+        "rhel-9.5 and below do not have bootupd bootloader update service":
+          when:
+            version_greater_or_equal: "9.2"
+            version_less_than: "9.6"
+          shallow_merge:
+            enabled_services:
+              - "NetworkManager.service"
+              - "firewalld.service"
+              - "sshd.service"
+              - "fdo-client-linuxapp.service"
+              - "ignition-firstboot-complete.service"
+              - "coreos-ignition-write-issues.service"
+        "rhel-9.5 and below do not have bootupd":
+          when:
+            version_less_than: "9.6"
+          shallow_merge:
+            bootupd_gen_metadata: false
     package_sets:
       os:
         - &edge_commit_pkgset
@@ -2915,13 +2936,13 @@ image_types:
           exclude:
             - "rng-tools"
           conditions: &conditions_pkgsets_edge_commit
-            "greenboot in 9.8 and c9s requires bootupd":
+            "greenboot in 9.6 and c9s requires bootupd":
               # we don't want bootupd in edge commits, but greenboot requires
-              # it in 9.8 and c9s, so we can only exclude it for older versions
+              # it in 9.6 and c9s, so we can only exclude it for older versions
               # NOTE: this is temporary
               # see https://github.com/fedora-iot/greenboot-rs/pull/142
               when:
-                version_less_than: "9.8"
+                version_less_than: "9.6"
               append:
                 exclude:
                   - "bootupd"
